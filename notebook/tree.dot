digraph Tree {
node [shape=box, style="filled", color="black", fontname="helvetica"] ;
edge [fontname="helvetica"] ;
0 [label="x2 <= 3.5\nsamples = 10\nvalue = [5, 5]\nclass = 0", fillcolor="#ffffff"] ;
1 [label="x1 <= 5.5\nsamples = 5\nvalue = [1, 4]\nclass = 1", fillcolor="#6ab6ec"] ;
0 -> 1 [labeldistance=2.5, labelangle=45, headlabel="True"] ;
2 [label="samples = 3\nvalue = [0, 3]\nclass = 1", fillcolor="#399de5"] ;
1 -> 2 ;
3 [label="samples = 2\nvalue = [1, 1]\nclass = 0", fillcolor="#ffffff"] ;
1 -> 3 ;
4 [label="x1 <= 2.5\nsamples = 5\nvalue = [4, 1]\nclass = 0", fillcolor="#eca06a"] ;
0 -> 4 [labeldistance=2.5, labelangle=-45, headlabel="False"] ;
5 [label="samples = 2\nvalue = [1, 1]\nclass = 0", fillcolor="#ffffff"] ;
4 -> 5 ;
6 [label="samples = 3\nvalue = [3, 0]\nclass = 0", fillcolor="#e58139"] ;
4 -> 6 ;
}